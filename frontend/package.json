{
  "name": "peach-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && vite build -c vite.pages.config.ts",
    "build:agentation": "vite build -c vite.agentation.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/react",
    "lint": "oxlint -c .oxlintrc.json src test e2e",
    "check:copy": "node scripts/copy-check.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node --test --test-concurrency=1 --test-reporter=tap \"e2e/**/*.test.ts\""
  },
  "dependencies": {
    "@remixicon/react": "4.9.0",
    "@tanstack/query-core": "5.104.3",
    "@tanstack/react-query": "5.104.3",
    "@tanstack/react-table": "9.3.1",
    "clsx": "2.1.1",
    "d3-sankey": "0.12.3",
    "motion": "14.3.0",
    "react": "19.3.1",
    "react-aria": "3.53.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@shadcn/lint": "0.2.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/d3-sankey": "0.12.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "agentation": "3.1.2",
    "happy-dom": "21.0.3",
    "oxc-parser": "0.154.0",
    "oxlint": "1.88.0",
    "playwright-core": "1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
